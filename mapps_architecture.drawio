        <!-- ==================== DATA FLOW NOTE ==================== -->
        <mxCell id="flow_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FAFAFA;strokeColor=#616161;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;Data Flow:&lt;/b&gt;&lt;br&gt;1. Business User → SSO → Access Matrix → ACE → Authorized&lt;br&gt;2. User → Frontend (Web Component) → NGINX → Flask API&lt;br&gt;3. Flask / Scheduler → Task Queue (Redis/Celery)&lt;br&gt;4. Workers consume → Model/Kernel → Adapter&lt;br&gt;5. Adapter connects external via Data Controller Interface&lt;br&gt;6. Adapter reads S3 (cache) + consumes Kafka (DMD/IPA TS)&lt;br&gt;7. Adapter → generates Report → S3 + Kafka publish&lt;br&gt;8. Celery/Redis reads config from Persistence (Flask Dict)&lt;br&gt;9. YAML routes tracked in OnePipeline (Azure DevOps)&lt;br&gt;10. All packaged as Azure Artifacts (Hexagonal arch)&lt;br&gt;11. MAPPS builds container (base img + model + adapter)&lt;br&gt;12. Container runs in ICHP (OpenShift K8s in IPC)" vertex="1">
          <mxGeometry x="2350" y="300" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- ==================== SAMPLE CONFIG ANNOTATION ==================== -->
