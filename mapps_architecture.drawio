        </mxCell>

        <!-- Access Matrix -->
        <mxCell id="ace_matrix" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="&lt;b&gt;📋 Access Matrix&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Role-Based Access Control&lt;/font&gt;" vertex="1" tooltip="Access Matrix defines which users/roles can access which resources. Managed centrally by ING. Controls read/write/execute permissions per application and environment.">
          <mxGeometry x="520" y="120" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Access Control Engine -->
        <mxCell id="ace_engine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=11;fontStyle=1;" value="&lt;b&gt;⚙️ ACE Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Policy Enforcement&lt;/font&gt;" vertex="1" tooltip="Access Control Engine enforces policies defined in the Access Matrix. Validates user tokens and permissions before allowing access to APIs and UI.">
          <mxGeometry x="760" y="120" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- Authorized Session -->
        <mxCell id="ace_session" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB74D;strokeColor=#E65100;fontSize=10;" value="✅ Authorized Session&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Token / Context&lt;/font&gt;" vertex="1" tooltip="After successful auth and access control, an authorized session token is created allowing the user to interact with the platform.">
