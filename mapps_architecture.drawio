        <mxCell id="c_workers_obs" edge="1" parent="1" source="ico_container" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#BF360C;strokeWidth=1;dashed=1;dashPattern=8 4;" target="ico_elk" value="&lt;font style=&quot;font-size:8px;&quot;&gt;metrics&lt;/font&gt;">
