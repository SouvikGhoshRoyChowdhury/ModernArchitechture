        </mxCell>
        <mxCell id="leg_be" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Backend/API" vertex="1">
          <mxGeometry x="210" y="40" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_proc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Processing" vertex="1">
          <mxGeometry x="330" y="40" width="90" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_data" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="Data/Storage" vertex="1">
          <mxGeometry x="440" y="40" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_ext" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="External Systems" vertex="1">
          <mxGeometry x="560" y="40" width="120" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_msg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Messaging" vertex="1">
          <mxGeometry x="700" y="40" width="90" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_infra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="Infrastructure" vertex="1">
          <mxGeometry x="810" y="40" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="leg_obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" value="Observability" vertex="1">
          <mxGeometry x="930" y="40" width="100" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 1: FRONTEND LAYER ==================== -->
        <mxCell id="grp_frontend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#2a5599;&quot;&gt;1. Frontend (FE)&lt;/b&gt;" vertex="1" tooltip="UI element framework (Java) → MAPPS Web Component. Includes all user-facing interfaces for report viewing, configuration, and job management.">
          <mxGeometry x="20" y="100" width="500" height="300" as="geometry" />
        </mxCell>
        <mxCell id="fe_webcomp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="MAPPS Web Component&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Java Framework → UI)&lt;/font&gt;" vertex="1" tooltip="UI element from Java framework rendered as MAPPS web component. Provides report visualization, job status, and configuration management UI.">
          <mxGeometry x="50" y="150" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fe_report_view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Report Viewer" vertex="1" tooltip="Displays processed report results (CapFloor, Bermudan, Swaption) to end users.">
          <mxGeometry x="50" y="230" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe_config_ui" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Config Manager UI" vertex="1" tooltip="Interface for managing SysConfig, scheduler settings, and adapter configurations.">
          <mxGeometry x="200" y="230" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe_job_monitor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Job Monitor" vertex="1" tooltip="Real-time monitoring of task queue status, worker health, and job progress.">
          <mxGeometry x="350" y="230" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe_user_req" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="User Request&lt;br&gt;Management" vertex="1" tooltip="Handles user-initiated report requests and deployment/sign-off workflows.">
          <mxGeometry x="350" y="150" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 2: BACKEND/API LAYER ==================== -->
        <mxCell id="grp_backend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#2d6b2d;&quot;&gt;1. Backend (BE) + 2. Data Controller Interface&lt;/b&gt;" vertex="1" tooltip="Flask API behind WSGI (NGINX). Exposes MAPPS functionality to TRM and external consumers. Handles API definition, routing, authentication.">
          <mxGeometry x="540" y="100" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="be_nginx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="WSGI (NGINX)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Reverse Proxy / Load Balancer&lt;/font&gt;" vertex="1" tooltip="NGINX serving as WSGI gateway. Handles SSL termination, load balancing, and request routing to Flask application.">
          <mxGeometry x="570" y="150" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be_flask" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Flask API&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;API Definition / Routes&lt;/font&gt;" vertex="1" tooltip="Core Flask application providing REST API endpoints. Defines all API routes for report submission, status checks, config CRUD, and TRM data controller interface.">
          <mxGeometry x="570" y="225" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be_flask_config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Flask Config" vertex="1" tooltip="Flask application configuration including environment-specific settings, database URIs, and feature flags.">
          <mxGeometry x="570" y="300" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="be_api_def" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="API Definition&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(OpenAPI/Swagger)&lt;/font&gt;" vertex="1" tooltip="API contract definitions. MAPPS exposed interface to TRM and other consumers.">
          <mxGeometry x="690" y="300" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="be_data_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" value="Data Controller&lt;br&gt;Interface&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(MAPPS exposed to TRM)&lt;/font&gt;" vertex="1" tooltip="Data Controller Interface: The API surface that MAPPS exposes to TRM. TRM has more visibility into MAPPS through this interface. Handles data exchange, validation, and transformation between MAPPS and TRM systems.">
          <mxGeometry x="830" y="150" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="be_auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Auth Module&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(External Data Source Auth)&lt;/font&gt;" vertex="1" tooltip="Authentication and authorization module for external data source connections. Part of section 3a: External data source connection (Auth).">
          <mxGeometry x="830" y="240" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_internal_comm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Internal System&lt;br&gt;Communication" vertex="1" tooltip="Section 3b: Internal system communication layer. Handles inter-service communication within MAPPS platform components.">
          <mxGeometry x="830" y="305" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Connection: NGINX to Flask -->
        <mxCell id="conn_nginx_flask" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="be_nginx" target="be_flask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connection: FE to NGINX -->
        <mxCell id="conn_fe_nginx" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=0;" edge="1" source="fe_webcomp" target="be_nginx" value="HTTP/REST">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 1 (cont): SCHEDULER + WORKERS + KERNEL ==================== -->
        <mxCell id="grp_processing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#8c6d00;&quot;&gt;1. Scheduler / Workers / Models / Kernel (Domain Code)&lt;/b&gt;" vertex="1" tooltip="Asynchronous execution layer. Celery workers process tasks from the task queue. Models/Kernel contains the core domain logic for report computation (CapFloor, Bermudan, Swaption pricing models).">
          <mxGeometry x="20" y="430" width="750" height="320" as="geometry" />
        </mxCell>
        <mxCell id="proc_scheduler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Scheduler&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(SysConfig driven)&lt;/font&gt;" vertex="1" tooltip="Job scheduler configured via SysConfig. Reads schedule configurations and dispatches tasks to the task queue. Manages cron-like job scheduling for report generation.">
          <mxGeometry x="50" y="490" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="proc_task_queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Task Queue&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Celery/Redis)&lt;/font&gt;" vertex="1" tooltip="Message broker-backed task queue (Celery with Redis/RabbitMQ). Holds pending tasks dispatched by the scheduler or triggered by API requests. Supports async, retry, and priority queuing.">
          <mxGeometry x="260" y="490" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="proc_workers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Celery Workers&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Async Execution)&lt;/font&gt;" vertex="1" tooltip="Celery worker processes that consume tasks from the queue. Execute domain logic asynchronously. Horizontally scalable. Each worker picks up tasks and runs Models/Kernel computation.">
          <mxGeometry x="470" y="490" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="proc_sysconfig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="SysConfig&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Schedule Config)&lt;/font&gt;" vertex="1" tooltip="System configuration that drives the scheduler. Contains cron expressions, job definitions, and execution parameters per report type.">
          <mxGeometry x="50" y="570" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="proc_models" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Models / Kernel&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Domain Code)&lt;/font&gt;" vertex="1" tooltip="Core domain logic containing business models and computation kernel. Implements pricing/valuation logic for CapFloor, Bermudan, Swaption reports. This is where the business-critical calculations reside.">
          <mxGeometry x="300" y="580" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="proc_adapter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" value="Adapter Kernel&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Config-driven)&lt;/font&gt;" vertex="1" tooltip="Adapter kernel that transforms data between external format and internal model format. Configuration-driven: adapters are selected/configured based on report type and source system.">
          <mxGeometry x="550" y="580" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="proc_contains_logic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;" value="Contains Logic&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Implements SysConfig)&lt;/font&gt;" vertex="1" tooltip="The domain logic implementation layer that reads SysConfig and executes accordingly. Contains business rules, validation, and computation orchestration.">
          <mxGeometry x="50" y="640" width="160" height="45" as="geometry" />
        </mxCell>

        <!-- Connections within processing -->
        <mxCell id="conn_sched_queue" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" source="proc_scheduler" target="proc_task_queue" value="dispatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_queue_workers" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" source="proc_task_queue" target="proc_workers" value="consume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_workers_models" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" source="proc_workers" target="proc_models" value="execute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_workers_adapter" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;" edge="1" source="proc_workers" target="proc_adapter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_flask_queue" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="be_flask" target="proc_task_queue" value="submit task">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 4: PERSISTENCE / STORAGE ==================== -->
        <mxCell id="grp_storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#8b2020;&quot;&gt;4. Persistence Storage (Shared S3 &amp; DB)&lt;/b&gt;" vertex="1" tooltip="Persistence layer including shared S3 buckets and databases. Stores: (a) preprocessed data (individual), (b) config data, (c) intermediate data including results. Shared across services.">
          <mxGeometry x="800" y="430" width="500" height="320" as="geometry" />
        </mxCell>
        <mxCell id="stor_s3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Shared S3&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Object Storage)&lt;/font&gt;" vertex="1" tooltip="Shared S3 bucket storage for large datasets, preprocessed files, and intermediate computation results. Accessible by all workers and services.">
          <mxGeometry x="840" y="490" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stor_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" value="Database&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Relational/NoSQL)&lt;/font&gt;" vertex="1" tooltip="Relational or NoSQL database for structured data. Stores config data, job metadata, user settings, and processed report results.">
          <mxGeometry x="1030" y="490" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stor_preproc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="4a. Preprocessed Data&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Individual)&lt;/font&gt;" vertex="1" tooltip="Store preprocessed data per individual report/job. Raw data transformed into computation-ready format before kernel execution.">
          <mxGeometry x="830" y="590" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="stor_config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="4b. Config Data" vertex="1" tooltip="Configuration data persistence. Stores SysConfig, adapter configurations, scheduler settings, and environment-specific parameters.">
          <mxGeometry x="1000" y="590" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="stor_intermediate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="4c. Intermediate Data&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Including Results)&lt;/font&gt;" vertex="1" tooltip="Intermediate computation data and final results storage. Workers write intermediate state here during long-running computations. Final report results are also persisted here.">
          <mxGeometry x="1140" y="590" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Connections: Workers to Storage -->
        <mxCell id="conn_workers_s3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" source="proc_workers" target="stor_s3" value="read/write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_models_db" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" source="proc_models" target="stor_db" value="persist results">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 3: EXTERNAL SYSTEMS (Integration Layer) ==================== -->
        <mxCell id="grp_external" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#5b3a7a;&quot;&gt;3. External Systems &amp; Integration&lt;/b&gt;" vertex="1" tooltip="External data source connections (3a) and internal system communication (3b). Includes TRM, Market Systems (Simob), MAPPS CHR, Adapters, and other external data providers requiring authentication.">
          <mxGeometry x="1340" y="100" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ext_trm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" value="TRM&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Trade Risk Management)&lt;/font&gt;" vertex="1" tooltip="TRM (Trade Risk Management) system. Has more visibility into MAPPS via the Data Controller Interface. Sends calculation requests and receives results. Primary consumer of MAPPS report data.">
          <mxGeometry x="1370" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ext_mapps_chr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" value="MAPPS CHR&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Calc)&lt;/font&gt;" vertex="1" tooltip="MAPPS CHR calculation engine. Provides core calculation capabilities. Connected to Service layer and Simob market data system.">
          <mxGeometry x="1580" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ext_simob" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Simob&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Market Data)&lt;/font&gt;" vertex="1" tooltip="Simob market data system. Provides real-time and historical market data feeds used in pricing calculations.">
          <mxGeometry x="1580" y="230" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ext_market_sys" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Market Systems&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Service → Simob)&lt;/font&gt;" vertex="1" tooltip="Market systems service layer that connects to Simob. Provides abstraction over market data access.">
          <mxGeometry x="1370" y="230" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ext_adapters" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="External Adapters" vertex="1" tooltip="External system adapters that connect MAPPS to third-party data sources. Each adapter handles authentication, data format conversion, and error handling for its specific external system.">
          <mxGeometry x="1370" y="300" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="Service Layer" vertex="1" tooltip="Service orchestration layer between MAPPS CHR and external market systems (Simob). Handles service discovery and routing.">
          <mxGeometry x="1550" y="300" width="120" height="45" as="geometry" />
        </mxCell>

        <!-- Connections: External -->
        <mxCell id="conn_trm_datactrl" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" source="ext_trm" target="be_data_ctrl" value="API calls">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_adapter_kernel" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#9673a6;strokeWidth=1;dashed=1;" edge="1" source="ext_adapters" target="proc_adapter" value="data feed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_mkt_simob" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#9673a6;strokeWidth=1;" edge="1" source="ext_market_sys" target="ext_simob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_chr_service" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#9673a6;strokeWidth=1;" edge="1" source="ext_mapps_chr" target="ext_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== MESSAGING LAYER (Kafka) ==================== -->
        <mxCell id="grp_messaging" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#8c5e00;&quot;&gt;Messaging Layer (Kafka)&lt;/b&gt;" vertex="1" tooltip="Kafka messaging infrastructure. Topics with Schema Registry for schema management. Supports multiple schema strategies (RecordNameStrategy). Used for event publishing between MAPPS components and external consumers.">
          <mxGeometry x="1340" y="430" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="msg_kafka" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" value="Kafka Cluster&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Hulk / Odin)&lt;/font&gt;" vertex="1" tooltip="Kafka cluster infrastructure. 'hulk' cluster for log topics, 'odin' cluster for business topics. Managed by platform team via KafkaContext wrapper.">
          <mxGeometry x="1470" y="490" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="msg_topic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Topics&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(mon_p06147_topic)&lt;/font&gt;" vertex="1" tooltip="Kafka topics for report event publishing. Example: mon_p06147_topic. Multiple report types (CapFloor, Bermudan, Swaption) can share a topic using RecordNameStrategy.">
          <mxGeometry x="1370" y="570" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="msg_schema_reg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Schema Registry&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Avro Schemas)&lt;/font&gt;" vertex="1" tooltip="Confluent Schema Registry storing Avro schemas. Supports RecordNameStrategy for multiple schemas per topic. Schema IDs are embedded in Confluent wire format message headers. Current MAPPS uses static AvroMapping(dev=1111, tst=2222, acc=3333, prd=4444) via KafkaContext.">
          <mxGeometry x="1560" y="570" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="msg_kafka_ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;dashed=1;" value="KafkaContext&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Platform Wrapper)&lt;/font&gt;" vertex="1" tooltip="Platform-provided KafkaContext wrapper from mapps_model_utils. Provides simplified Kafka producer/consumer access with static schema ID mapping per environment. Usage: with KafkaContext(topic, cluster_name, avro_schema_id=AvroMapping(...)) as kafka:">
          <mxGeometry x="1370" y="650" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="msg_subscriptions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Subscriptions&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Event Hubs / CReSub)&lt;/font&gt;" vertex="1" tooltip="Topic and schema subscriptions. Event Hubs integration and CReSub (Create/Subscribe) patterns for consumer group management.">
          <mxGeometry x="1560" y="650" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Connections: Messaging -->
        <mxCell id="conn_topic_kafka" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d79b00;strokeWidth=1;" edge="1" source="msg_topic" target="msg_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_schema_kafka" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d79b00;strokeWidth=1;" edge="1" source="msg_schema_reg" target="msg_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_workers_kafka" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" source="proc_workers" target="msg_kafka" value="publish results">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 5: DEPLOYMENT / INFRA ==================== -->
        <mxCell id="grp_deploy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#333;&quot;&gt;5. Deployment &amp; 6. PR / Release Process&lt;/b&gt;" vertex="1" tooltip="Deployment infrastructure. Extends and is part of existing infrastructure. Includes: PR workflow, Signoff for Prod release, Change Management, Release processes, ICHP (changes). External deployments also part of existing infra.">
          <mxGeometry x="20" y="790" width="750" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dep_ichp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" value="ICHP&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Infrastructure Changes)&lt;/font&gt;" vertex="1" tooltip="ICHP (Infrastructure Change Process). Manages infrastructure changes, container deployments, and platform configuration updates. All production changes flow through ICHP approval.">
          <mxGeometry x="50" y="840" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dep_containers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" value="Containers&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Docker/K8s)&lt;/font&gt;" vertex="1" tooltip="Containerized deployment using Docker and Kubernetes. All MAPPS services (Flask API, Celery workers, Scheduler) run as containers. Supports horizontal scaling of workers.">
          <mxGeometry x="250" y="840" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dep_pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" value="PR / Code Review&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Git Workflow)&lt;/font&gt;" vertex="1" tooltip="Pull Request and code review workflow. All code changes require PR approval before merge. Part of the release pipeline.">
          <mxGeometry x="450" y="840" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dep_change_mgmt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="Change Management&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Signoff for Prod)&lt;/font&gt;" vertex="1" tooltip="Change management and production sign-off process. All production releases require change management approval and sign-off before deployment.">
          <mxGeometry x="50" y="920" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_release" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="Release Process&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(CI/CD Pipeline)&lt;/font&gt;" vertex="1" tooltip="Release process including CI/CD pipeline. Automated build, test, and deployment. Environments: dev → tst → acc → prd.">
          <mxGeometry x="250" y="920" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_existing_infra" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" value="Existing Infra&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Platform Shared)&lt;/font&gt;" vertex="1" tooltip="Existing shared infrastructure provided by the platform team. MAPPS deployment extends this existing infra. External deployments are also part of this.">
          <mxGeometry x="450" y="920" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Connections: Deployment -->
        <mxCell id="conn_pr_release" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#666;strokeWidth=1;" edge="1" source="dep_pr" target="dep_release" value="merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_release_ichp" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#666;strokeWidth=1;" edge="1" source="dep_release" target="dep_ichp" value="deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_ichp_containers" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#666;strokeWidth=1;" edge="1" source="dep_ichp" target="dep_containers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== SECTION 7: OBSERVABILITY / ALERTS ==================== -->
        <mxCell id="grp_observability" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;opacity=30;" value="&lt;b style=&quot;font-size:14px;color:#0a5a7a;&quot;&gt;7. Observability / Alerts&lt;/b&gt;" vertex="1" tooltip="Observability and alerting layer. Monitors all MAPPS components including API health, worker status, task queue depth, job success/failure rates, and infrastructure metrics. Alerts on anomalies and failures.">
          <mxGeometry x="800" y="790" width="500" height="220" as="geometry" />
        </mxCell>
        <mxCell id="obs_monitoring" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;fontStyle=1;" value="Monitoring&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Metrics/Dashboards)&lt;/font&gt;" vertex="1" tooltip="Monitoring infrastructure collecting metrics from all services. Dashboards for real-time visibility into system health, job throughput, and error rates.">
          <mxGeometry x="830" y="840" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="obs_logging" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;fontStyle=1;" value="Logging&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Centralized)&lt;/font&gt;" vertex="1" tooltip="Centralized logging aggregation. All service logs shipped to central platform. Supports structured logging, search, and correlation across services.">
          <mxGeometry x="1040" y="840" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="obs_alerts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=12;fontStyle=1;" value="Alerting&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;(Thresholds/Anomaly)&lt;/font&gt;" vertex="1" tooltip="Alerting system with threshold-based and anomaly detection alerts. Notifies team on job failures, high latency, queue backlog, and infrastructure issues.">
          <mxGeometry x="830" y="920" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="obs_tracing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" value="Tracing&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Request Correlation)&lt;/font&gt;" vertex="1" tooltip="Distributed tracing for request correlation across MAPPS services. Tracks request flow from API → Task Queue → Worker → Storage.">
          <mxGeometry x="1040" y="920" width="170" height="55" as="geometry" />
        </mxCell>

        <!-- ==================== CROSS-CUTTING CONNECTIONS ==================== -->
        <!-- FE to Job Monitor (Task Queue visibility) -->
        <mxCell id="conn_jobmon_queue" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;" edge="1" source="fe_job_monitor" target="proc_task_queue" value="status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data Controller to TRM (bidirectional implied) -->
        <mxCell id="conn_flask_datactrl" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#82b366;strokeWidth=1;" edge="1" source="be_flask" target="be_data_ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Observability connections -->
        <mxCell id="conn_workers_obs" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#10739e;strokeWidth=1;dashed=1;" edge="1" source="proc_workers" target="obs_monitoring" value="metrics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_flask_obs" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#10739e;strokeWidth=1;dashed=1;" edge="1" source="be_flask" target="obs_logging" value="logs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Kafka to Observability (log topic via hulk cluster) -->
        <mxCell id="conn_kafka_logging" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#10739e;strokeWidth=1;dashed=1;" edge="1" source="msg_kafka" target="obs_logging" value="log events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
