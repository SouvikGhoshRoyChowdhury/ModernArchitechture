        <!-- Model/Kernel implemented by Adapter -->
        <mxCell id="proc_model_kernel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4FC3F7;strokeColor=#0277BD;fontSize=12;fontStyle=1;strokeWidth=2;" value="&lt;b&gt;🧠 Model / Kernel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Domain Logic (Python)&lt;/font&gt;" vertex="1" tooltip="Core domain/business logic - Model and computation Kernel. Implemented BY the Adapter which connects to external systems via Data Controller Interface.">
