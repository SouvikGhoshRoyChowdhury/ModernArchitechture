        </mxCell>
        <mxCell id="proc_workers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4FC3F7;strokeColor=#0277BD;fontSize=12;fontStyle=1;" value="&lt;b&gt;🏗️ Celery Workers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Async Execution&lt;/font&gt;" vertex="1">
