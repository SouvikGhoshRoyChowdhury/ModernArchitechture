        <!-- ==================== PERSISTENCE STORAGE ==================== -->
        <mxCell id="bnd_storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#616161;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;arcSize=6;" value="&lt;b style=&quot;font-size:16px;color:#212121;&quot;&gt;Persistence Storage&lt;/b&gt;" vertex="1">
