        <!-- ======================================================================== -->
        <!-- DATA FLOW NOTE -->
        <!-- ======================================================================== -->
        <mxCell id="flow_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FAFAFA;strokeColor=#616161;fontSize=10;align=left;spacingLeft=8;rounded=0;" value="&lt;b&gt;Data Flow:&lt;/b&gt;&lt;br&gt;1. Business User → SSO → Access Matrix → ACE → Authorized&lt;br&gt;2. User → Frontend → NGINX → Flask API&lt;br&gt;3. Flask / Scheduler → Task Queue (Redis/Celery)&lt;br&gt;4. Workers → Model/Kernel → Adapter (implements it)&lt;br&gt;5. Adapter connects external via Data Controller Interface&lt;br&gt;6. Adapter reads S3 (cache) + consumes Kafka (DMD/IPA TS)&lt;br&gt;7. Adapter → generates Report → S3 + Kafka publish&lt;br&gt;8. Celery/Redis reads config from Persistence (Flask Dict)&lt;br&gt;9. YAML routes tracked in OnePipeline (Azure DevOps)&lt;br&gt;10. All packaged as Azure Artifacts (Hexagonal arch)&lt;br&gt;11. MAPPS builds container (base img + model + adapter)&lt;br&gt;12. Container runs in ICHP (OpenShift K8s in IPC)&lt;br&gt;&lt;br&gt;&lt;b&gt;Line Significance (UML Standard):&lt;/b&gt;&lt;br&gt;━━━ &lt;b&gt;Solid:&lt;/b&gt; Direct/synchronous dependency or call&lt;br&gt;╌╌╌ &lt;b&gt;Dashed:&lt;/b&gt; Asynchronous / event-driven / optional path&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(e.g., Kafka consume/publish, telemetry, S3 read/write are async)&lt;/font&gt;" vertex="1">
          <mxGeometry x="3100" y="580" width="400" height="300" as="geometry" />
        </mxCell>

        <!-- ======================================================================== -->
        <!-- SAMPLE CONFIG NOTE (from YAML screenshot) -->
        <!-- ======================================================================== -->
        <mxCell id="config_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FAFAFA;strokeColor=#616161;fontSize=9;align=left;spacingLeft=6;rounded=0;" value="&lt;b&gt;Sample YAML Config (per project in OnePipeline):&lt;/b&gt;&lt;br&gt;&lt;br&gt;views:&lt;br&gt;  - component_path: src/s3_manager.js&lt;br&gt;    web_component: common-etl-s3-view&lt;br&gt;  - component_path: src/gmdb_manager.js&lt;br&gt;    web_component: common-etl-gmdb-test-view&lt;br&gt;  - component_path: src/kafka_manager.js&lt;br&gt;    web_component: kafka-manager-common-etl-view&lt;br&gt;&lt;br&gt;apis:&lt;br&gt;  - function_name: generate_implied_forwards_data&lt;br&gt;    sub_module: api | method: post&lt;br&gt;  - function_name: consumer_for_adapter&lt;br&gt;    sub_module: kafka_api | method: post&lt;br&gt;  - function_name: producer_for_adapter&lt;br&gt;    sub_module: kafka_api | method: post&lt;br&gt;  - function_name: s3_file_manager&lt;br&gt;    sub_module: api | method: post/get/delete/put&lt;br&gt;  - function_name: gmdb_query_api&lt;br&gt;    sub_module: gmdb_api | method: post&lt;br&gt;  - function_name: get_kafka_config&lt;br&gt;    sub_module: api | method: get&lt;br&gt;&lt;br&gt;scheduled_jobs:&lt;br&gt;  - function_name: trigger_fx_spot_fetcher_cron&lt;br&gt;    sub_module: scheduled_tasks&lt;br&gt;    cron_params: '0 7 1-3 * 1-5'&lt;br&gt;    allow_concurrent: false&lt;br&gt;    time_zone: Europe/Amsterdam" vertex="1">
          <mxGeometry x="3100" y="920" width="400" height="400" as="geometry" />
        </mxCell>

