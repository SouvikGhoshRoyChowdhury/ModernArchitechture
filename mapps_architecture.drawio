<mxfile host="Electron" modified="2026-07-01T10:14:00.000Z" agent="draw.io" version="24.0.0">
  <diagram id="MAPPS_Architecture" name="MAPPS Platform Architecture">
    <mxGraphModel dx="3200" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2000" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE BAR ==================== -->
        <mxCell id="title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" value="MAPPS Platform — Low-Level Architecture" vertex="1">
          <mxGeometry x="900" y="15" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: USERS / FRONTEND ==================== -->
        <mxCell id="bnd_users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#1565C0;&quot;&gt;👤 Frontend / UI Layer&lt;/b&gt;" vertex="1" tooltip="User-facing layer. Java-based UI element framework rendered as MAPPS Web Component. Users interact with report viewer, config management, and job monitoring interfaces.">
          <mxGeometry x="40" y="70" width="520" height="380" as="geometry" />
        </mxCell>
        <mxCell id="fe_icon_java" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://img.icons8.com/color/48/java-coffee-cup-logo.png;" vertex="1">
          <mxGeometry x="70" y="110" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fe_webcomp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;MAPPS Web Component&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Java UI Framework&lt;/font&gt;" vertex="1" tooltip="UI element from Java framework. Rendered as MAPPS web component for report visualization and management.">
          <mxGeometry x="120" y="110" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_report" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;shadow=1;" value="📊 Report Viewer" vertex="1" tooltip="Displays computed report results (CapFloor, Bermudan, Swaption) to end users with filtering and export capabilities.">
          <mxGeometry x="60" y="190" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe_config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;shadow=1;" value="⚙️ Config Manager" vertex="1" tooltip="UI for managing SysConfig, scheduler settings, adapter configurations, and environment-specific parameters.">
          <mxGeometry x="220" y="190" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe_jobmon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;shadow=1;" value="📋 Job Monitor" vertex="1" tooltip="Real-time monitoring of Celery task queue status, worker health, and job progress. Shows running/pending/failed jobs.">
          <mxGeometry x="380" y="190" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe_user_req" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;shadow=1;" value="📝 User Request &amp;&lt;br&gt;Deployment Signoff" vertex="1" tooltip="Handles user-initiated report requests, deployment approvals, and production sign-off workflows.">
          <mxGeometry x="60" y="260" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: BACKEND / API GATEWAY ==================== -->
        <mxCell id="bnd_backend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#2E7D32;&quot;&gt;🌐 Backend / API Layer&lt;/b&gt;" vertex="1" tooltip="Flask API behind WSGI (NGINX). Exposes MAPPS functionality via REST API. Handles routing, authentication, and request processing. Data Controller Interface exposes MAPPS to TRM.">
          <mxGeometry x="600" y="70" width="620" height="380" as="geometry" />
        </mxCell>
        <mxCell id="be_nginx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;🔒 NGINX&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;WSGI / Reverse Proxy&lt;/font&gt;" vertex="1" tooltip="NGINX as WSGI gateway. Handles SSL termination, load balancing, rate limiting, and proxies requests to Flask app.">
          <mxGeometry x="630" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_flask" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;🐍 Flask API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;REST Endpoints / Routes&lt;/font&gt;" vertex="1" tooltip="Core Flask application. Defines REST API routes for report submission, job status, config CRUD. Serves as the API definition layer with OpenAPI/Swagger docs.">
          <mxGeometry x="630" y="200" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="be_flask_config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;shadow=1;" value="🔧 Flask Config&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;API Definition&lt;/font&gt;" vertex="1" tooltip="Flask configuration and API contract definitions. Environment-specific settings (dev/tst/acc/prd), feature flags, database URIs.">
          <mxGeometry x="630" y="275" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="be_data_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#1B5E20;fontSize=12;fontStyle=1;shadow=1;strokeWidth=2;" value="&lt;b&gt;🔗 Data Controller Interface&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;MAPPS exposed to TRM&lt;/font&gt;" vertex="1" tooltip="Data Controller Interface: The API surface MAPPS exposes to TRM. TRM has more visibility into MAPPS through this interface. Handles structured data exchange, validation, and transformation.">
          <mxGeometry x="870" y="120" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be_auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;shadow=1;" value="🔑 Auth Module&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;External Data Source Auth&lt;/font&gt;" vertex="1" tooltip="Section 3a: Authentication module for external data source connections. Manages credentials, tokens, and access to third-party systems.">
          <mxGeometry x="870" y="200" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="be_internal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;shadow=1;" value="🔄 Internal System Comm&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Inter-service messaging&lt;/font&gt;" vertex="1" tooltip="Section 3b: Internal system communication layer. Handles inter-service communication within MAPPS platform components using internal protocols.">
          <mxGeometry x="870" y="265" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- Connection: FE → NGINX -->
        <mxCell id="conn_fe_nginx" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#1565C0;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="fe_webcomp" target="be_nginx" value="&lt;font style=&quot;font-size:10px;&quot;&gt;HTTPS&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Connection: NGINX → Flask -->
        <mxCell id="conn_nginx_flask" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" source="be_nginx" target="be_flask" value="&lt;font style=&quot;font-size:9px;&quot;&gt;proxy&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: PROCESSING / ASYNC EXECUTION ==================== -->
        <mxCell id="bnd_processing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#F57F17;&quot;&gt;⚡ Async Processing Layer (Celery)&lt;/b&gt;" vertex="1" tooltip="Asynchronous execution engine. Scheduler reads SysConfig, dispatches tasks to Redis-backed Celery queue. Workers consume tasks, execute domain kernel logic. Horizontal scaling via container orchestration.">
          <mxGeometry x="40" y="490" width="870" height="370" as="geometry" />
        </mxCell>
        <mxCell id="proc_sysconfig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=11;fontStyle=1;shadow=1;" value="📄 SysConfig&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Schedule Configuration&lt;/font&gt;" vertex="1" tooltip="System configuration that drives the scheduler. Contains cron expressions, job definitions, execution parameters, and report type configurations per environment.">
          <mxGeometry x="70" y="550" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="proc_scheduler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#F57F17;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;⏰ Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Reads SysConfig&lt;/font&gt;" vertex="1" tooltip="Job scheduler component. Reads schedule configurations from SysConfig and dispatches tasks to the Celery task queue. Supports cron-like scheduling for automated report generation.">
          <mxGeometry x="70" y="640" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="proc_taskqueue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=12;fontStyle=1;shadow=1;strokeWidth=2;" value="&lt;b&gt;📨 Task Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Redis / Celery Broker&lt;/font&gt;" vertex="1" tooltip="Message broker-backed task queue (Celery with Redis). Holds pending tasks dispatched by scheduler or API. Supports async execution, retry logic, priority queuing, and dead-letter handling.">
          <mxGeometry x="290" y="590" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="proc_workers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE082;strokeColor=#F57F17;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;🏗️ Celery Workers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Async Execution&lt;/font&gt;" vertex="1" tooltip="Celery worker processes consuming tasks from the queue. Execute domain logic asynchronously. Horizontally scalable via Kubernetes. Each worker runs Models/Kernel computation.">
          <mxGeometry x="540" y="590" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="proc_kernel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=12;fontStyle=1;shadow=1;strokeWidth=2;" value="&lt;b&gt;🧠 Models / Kernel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Domain Code (Python)&lt;/font&gt;" vertex="1" tooltip="Core domain logic. Contains business models and computation kernel. Implements pricing/valuation logic for CapFloor, Bermudan, Swaption reports. Contains logic that implements SysConfig-driven behavior.">
          <mxGeometry x="340" y="700" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="proc_adapter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;fontSize=11;shadow=1;" value="🔌 Adapter Kernel&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Config-Driven Transforms&lt;/font&gt;" vertex="1" tooltip="Adapter kernel transforming data between external format and internal model format. Configuration-driven: adapters selected based on report type and source system. Config → Adapter Kernel pattern.">
          <mxGeometry x="610" y="700" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="proc_contains" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#F57F17;fontSize=9;dashed=1;strokeWidth=1;" value="contains logic / implements SysConfig" vertex="1" tooltip="The domain logic implementation layer that reads SysConfig and executes accordingly.">
          <mxGeometry x="70" y="720" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Processing connections -->
        <mxCell id="conn_sys_sched" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#F57F17;strokeWidth=2;" edge="1" source="proc_sysconfig" target="proc_scheduler" value="&lt;font style=&quot;font-size:9px;&quot;&gt;reads&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_sched_queue" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#E65100;strokeWidth=2;" edge="1" source="proc_scheduler" target="proc_taskqueue" value="&lt;font style=&quot;font-size:9px;&quot;&gt;dispatch&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_queue_workers" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#E65100;strokeWidth=2;" edge="1" source="proc_taskqueue" target="proc_workers" value="&lt;font style=&quot;font-size:9px;&quot;&gt;consume&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_workers_kernel" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#F57F17;strokeWidth=2;" edge="1" source="proc_workers" target="proc_kernel" value="&lt;font style=&quot;font-size:9px;&quot;&gt;execute&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_workers_adapter" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#F57F17;strokeWidth=1;dashed=1;" edge="1" source="proc_workers" target="proc_adapter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Flask → Task Queue -->
        <mxCell id="conn_flask_queue" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#2E7D32;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="be_flask" target="proc_taskqueue" value="&lt;font style=&quot;font-size:9px;&quot;&gt;submit task&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: EXTERNAL SYSTEMS ==================== -->
        <mxCell id="bnd_external" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#6A1B9A;&quot;&gt;🏢 External Systems &amp; Integration&lt;/b&gt;" vertex="1" tooltip="External data sources and integration layer. Includes TRM (Trade Risk Management), MAPPS CHR (Calculation), Simob (Market Data), and Market Systems service layer. Section 3a: External data source connections (Auth). Section 3b: Internal system communication.">
          <mxGeometry x="1260" y="70" width="530" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ext_trm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;🏦 TRM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Trade Risk Management&lt;/font&gt;" vertex="1" tooltip="TRM (Trade Risk Management) system. Primary consumer of MAPPS data. Has more visibility into MAPPS via Data Controller Interface. Sends calculation requests and receives report results.">
          <mxGeometry x="1290" y="130" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ext_chr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#6A1B9A;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;🧮 MAPPS CHR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Calculation Engine&lt;/font&gt;" vertex="1" tooltip="MAPPS CHR calculation engine. Provides core pricing calculation capabilities. Connected via Service layer to Simob market data.">
          <mxGeometry x="1540" y="130" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ext_market" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;shadow=1;" value="📡 Market Systems&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Service Layer&lt;/font&gt;" vertex="1" tooltip="Market systems service layer that connects to Simob. Provides abstraction over market data access and routing.">
          <mxGeometry x="1290" y="220" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_simob" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;shadow=1;" value="📈 Simob&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Market Data Feed&lt;/font&gt;" vertex="1" tooltip="Simob market data system. Provides real-time and historical market data feeds (rates, curves, volatilities) used in pricing calculations.">
          <mxGeometry x="1500" y="220" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_adapters" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;shadow=1;" value="🔌 External Adapters&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Data Source Connectors&lt;/font&gt;" vertex="1" tooltip="External adapters connecting MAPPS to third-party data sources. Each adapter handles authentication, data format conversion, error handling for its external system.">
          <mxGeometry x="1290" y="300" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ext_service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;fontSize=11;shadow=1;" value="⚙️ Service Layer&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;CHR ↔ Simob&lt;/font&gt;" vertex="1" tooltip="Service orchestration layer between MAPPS CHR and external market systems. Handles service discovery, routing, and protocol translation.">
          <mxGeometry x="1540" y="300" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- External connections -->
        <mxCell id="conn_trm_dc" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=2;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="ext_trm" target="be_data_ctrl" value="&lt;font style=&quot;font-size:9px;&quot;&gt;API↔&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_mkt_simob" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=1;" edge="1" source="ext_market" target="ext_simob" value="&lt;font style=&quot;font-size:9px;&quot;&gt;data&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_chr_svc" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=1;" edge="1" source="ext_chr" target="ext_service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_adapter_ext" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#6A1B9A;strokeWidth=1;dashed=1;" edge="1" source="ext_adapters" target="proc_adapter" value="&lt;font style=&quot;font-size:9px;&quot;&gt;data feed&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: PERSISTENCE / STORAGE ==================== -->
        <mxCell id="bnd_storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#C62828;&quot;&gt;💾 Persistence Storage&lt;/b&gt;" vertex="1" tooltip="Section 4: Persistence layer. Shared S3 buckets and databases. Stores: (a) preprocessed data (individual), (b) config data, (c) intermediate data including results. Shared across all services.">
          <mxGeometry x="960" y="490" width="530" height="370" as="geometry" />
        </mxCell>
        <mxCell id="stor_s3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;☁️ Shared S3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Object Storage&lt;/font&gt;" vertex="1" tooltip="AWS S3 shared bucket storage for large datasets, preprocessed files, computation results, and archived reports. Accessible by all workers and services.">
          <mxGeometry x="1000" y="560" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stor_db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=12;fontStyle=1;shadow=1;" value="&lt;b&gt;🗄️ Database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;PostgreSQL / NoSQL&lt;/font&gt;" vertex="1" tooltip="Relational database (PostgreSQL) for structured data. Stores config data, job metadata, user settings, and processed report results. May also include NoSQL for document storage.">
          <mxGeometry x="1200" y="560" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stor_preproc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;shadow=1;" value="4a. Preprocessed Data&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Individual reports)&lt;/font&gt;" vertex="1" tooltip="Store preprocessed data per individual report/job. Raw data transformed into computation-ready format before kernel execution.">
          <mxGeometry x="990" y="670" width="145" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stor_config" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;shadow=1;" value="4b. Config Data" vertex="1" tooltip="Configuration data persistence. Stores SysConfig, adapter configurations, scheduler settings, and environment-specific parameters.">
          <mxGeometry x="1155" y="670" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stor_results" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;shadow=1;" value="4c. Intermediate Data&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Including Results)&lt;/font&gt;" vertex="1" tooltip="Intermediate computation data and final results storage. Workers write intermediate state during long-running jobs. Final report results persisted here for retrieval by API/UI.">
          <mxGeometry x="1285" y="670" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Storage connections -->
        <mxCell id="conn_workers_s3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#C62828;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="proc_workers" target="stor_s3" value="&lt;font style=&quot;font-size:9px;&quot;&gt;read/write&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_kernel_db" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#C62828;strokeWidth=1;dashed=1;" edge="1" source="proc_kernel" target="stor_db" value="&lt;font style=&quot;font-size:9px;&quot;&gt;persist&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: KAFKA MESSAGING ==================== -->
        <mxCell id="bnd_kafka" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#E65100;&quot;&gt;📬 Messaging Layer (Kafka)&lt;/b&gt;" vertex="1" tooltip="Kafka messaging infrastructure. Schema Registry for Avro schema management. Supports RecordNameStrategy for multiple schemas per topic. KafkaContext wrapper from mapps_model_utils provides platform-standard access.">
          <mxGeometry x="1540" y="490" width="500" height="370" as="geometry" />
        </mxCell>
        <mxCell id="msg_kafka" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=12;fontStyle=1;shadow=1;strokeWidth=2;" value="&lt;b&gt;📡 Kafka Cluster&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Hulk (logs) / Odin (business)&lt;/font&gt;" vertex="1" tooltip="Kafka cluster infrastructure. 'hulk' cluster for log topics, 'odin' cluster for business event topics. Managed by platform team. Provides high-throughput, distributed event streaming.">
          <mxGeometry x="1640" y="550" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="msg_topics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;shadow=1;" value="📋 Topics&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;mon_p06147_topic&lt;/font&gt;" vertex="1" tooltip="Kafka topics for report event publishing. Example: mon_p06147_topic. Multiple report types (CapFloor, Bermudan, Swaption) can share a topic using RecordNameStrategy or Envelope schema.">
          <mxGeometry x="1570" y="640" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="msg_schema" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;shadow=1;" value="📐 Schema Registry&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Avro Schemas&lt;/font&gt;" vertex="1" tooltip="Confluent Schema Registry storing Avro schemas. Schema IDs embedded in Confluent wire format. Supports RecordNameStrategy for multiple schemas per topic. Provides schema evolution and compatibility checks.">
          <mxGeometry x="1740" y="640" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="msg_kafkactx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;shadow=1;dashed=1;" value="🐍 KafkaContext&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;mapps_model_utils wrapper&lt;/font&gt;" vertex="1" tooltip="Platform-provided KafkaContext wrapper (from mapps_model_utils). Simplified Kafka producer/consumer with static AvroMapping per env. Usage: KafkaContext(topic, cluster_name, avro_schema_id=AvroMapping(dev=..., prd=...))">
          <mxGeometry x="1570" y="720" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="msg_subscriptions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=11;shadow=1;" value="🔔 Subscriptions&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Event Hubs / CReSub&lt;/font&gt;" vertex="1" tooltip="Topic and schema subscriptions. Event Hubs integration and CReSub (Create/Subscribe) patterns for consumer group management and event routing.">
          <mxGeometry x="1770" y="720" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Kafka connections -->
        <mxCell id="conn_topic_kafka" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#E65100;strokeWidth=1;" edge="1" source="msg_topics" target="msg_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_schema_kafka" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#E65100;strokeWidth=1;" edge="1" source="msg_schema" target="msg_kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_workers_kafka" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#E65100;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="proc_kernel" target="msg_kafka" value="&lt;font style=&quot;font-size:9px;&quot;&gt;publish results&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: DEPLOYMENT / CI-CD ==================== -->
        <mxCell id="bnd_deploy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#37474F;&quot;&gt;🚀 Deployment &amp; Release (CI/CD)&lt;/b&gt;" vertex="1" tooltip="Section 5 &amp; 6: Deployment infrastructure. Extends existing platform infra. Includes: PR workflow, Signoff for Prod release, Change Management, Release processes, ICHP (infrastructure changes). Containerized via Docker/Kubernetes.">
          <mxGeometry x="40" y="900" width="870" height="240" as="geometry" />
        </mxCell>
        <mxCell id="dep_pr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#37474F;fontSize=11;fontStyle=1;shadow=1;" value="&lt;b&gt;🔀 PR / Code Review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Git Workflow&lt;/font&gt;" vertex="1" tooltip="Pull Request and code review workflow. All code changes require PR approval before merge. Automated checks run on PR.">
          <mxGeometry x="70" y="960" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_signoff" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#37474F;fontSize=11;shadow=1;" value="✅ Signoff for Prod&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Change Management&lt;/font&gt;" vertex="1" tooltip="Production sign-off and change management process. All production releases require approval and sign-off before deployment.">
          <mxGeometry x="260" y="960" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_release" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#37474F;fontSize=11;shadow=1;" value="📦 Release Process&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;CI/CD Pipeline&lt;/font&gt;" vertex="1" tooltip="Release process with CI/CD pipeline. Automated build → test → deploy. Environments: dev → tst → acc → prd.">
          <mxGeometry x="460" y="960" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_ichp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#37474F;fontSize=11;fontStyle=1;shadow=1;" value="&lt;b&gt;🏗️ ICHP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Infrastructure Changes&lt;/font&gt;" vertex="1" tooltip="ICHP (Infrastructure Change Process). Manages infra changes, container deployments, platform config updates. All production infra changes flow through ICHP.">
          <mxGeometry x="660" y="960" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_containers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0BEC5;strokeColor=#37474F;fontSize=11;fontStyle=1;shadow=1;" value="&lt;b&gt;🐳 Containers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Docker / Kubernetes&lt;/font&gt;" vertex="1" tooltip="Containerized deployment using Docker and Kubernetes. All MAPPS services (Flask API, Celery workers, Scheduler, NGINX) run as containers. Supports horizontal scaling and orchestration.">
          <mxGeometry x="260" y="1050" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep_existing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#37474F;fontSize=10;shadow=1;dashed=1;" value="Existing Infra (Platform)" vertex="1" tooltip="Existing shared infrastructure provided by platform team. MAPPS deployment extends this infra. External deployments are also part of this shared platform.">
          <mxGeometry x="500" y="1055" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Deploy connections -->
        <mxCell id="conn_pr_sign" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#37474F;strokeWidth=1;" edge="1" source="dep_pr" target="dep_signoff" value="&lt;font style=&quot;font-size:8px;&quot;&gt;approve&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_sign_rel" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#37474F;strokeWidth=1;" edge="1" source="dep_signoff" target="dep_release" value="&lt;font style=&quot;font-size:8px;&quot;&gt;release&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_rel_ichp" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#37474F;strokeWidth=1;" edge="1" source="dep_release" target="dep_ichp" value="&lt;font style=&quot;font-size:8px;&quot;&gt;deploy&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_ichp_cont" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#37474F;strokeWidth=1;" edge="1" source="dep_ichp" target="dep_containers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== BOUNDARY: OBSERVABILITY ==================== -->
        <mxCell id="bnd_observability" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00695C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;shadow=1;arcSize=8;" value="&lt;b style=&quot;font-size:15px;color:#00695C;&quot;&gt;👁️ Observability / Alerts&lt;/b&gt;" vertex="1" tooltip="Section 7: Observability and alerting layer. Monitors API health, worker status, task queue depth, job success/failure rates, infrastructure metrics. Centralized logging via Kafka hulk cluster.">
          <mxGeometry x="960" y="900" width="580" height="240" as="geometry" />
        </mxCell>
        <mxCell id="obs_monitoring" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00695C;fontSize=11;fontStyle=1;shadow=1;" value="&lt;b&gt;📊 Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Metrics / Dashboards&lt;/font&gt;" vertex="1" tooltip="Monitoring infrastructure (Prometheus/Grafana style). Collects metrics from all services. Dashboards for real-time visibility into system health, job throughput, error rates.">
          <mxGeometry x="990" y="960" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="obs_logging" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00695C;fontSize=11;fontStyle=1;shadow=1;" value="&lt;b&gt;📝 Centralized Logging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;ELK / Splunk&lt;/font&gt;" vertex="1" tooltip="Centralized logging aggregation (ELK stack or Splunk). All service logs shipped centrally. Supports structured logging, full-text search, and cross-service correlation.">
          <mxGeometry x="1190" y="960" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="obs_alerts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00695C;fontSize=11;fontStyle=1;shadow=1;" value="&lt;b&gt;🚨 Alerting&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;Thresholds / PagerDuty&lt;/font&gt;" vertex="1" tooltip="Alerting system with threshold-based and anomaly detection. Notifies team on job failures, high latency, queue backlog, infrastructure issues via PagerDuty/Slack/email.">
          <mxGeometry x="1400" y="960" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="obs_tracing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00695C;fontSize=11;shadow=1;" value="🔍 Distributed Tracing&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Request Correlation&lt;/font&gt;" vertex="1" tooltip="Distributed tracing (Jaeger/Zipkin). Tracks request flow across MAPPS services: API → Queue → Worker → Storage → Kafka.">
          <mxGeometry x="990" y="1050" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- Observability connections -->
        <mxCell id="conn_workers_mon" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#00695C;strokeWidth=1;dashed=1;" edge="1" source="proc_workers" target="obs_monitoring" value="&lt;font style=&quot;font-size:8px;&quot;&gt;metrics&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_flask_log" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#00695C;strokeWidth=1;dashed=1;" edge="1" source="be_flask" target="obs_logging" value="&lt;font style=&quot;font-size:8px;&quot;&gt;logs&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn_kafka_log" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jetSize=auto;html=1;strokeColor=#00695C;strokeWidth=1;dashed=1;" edge="1" source="msg_kafka" target="obs_logging" value="&lt;font style=&quot;font-size:8px;&quot;&gt;log events (hulk)&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== FLOW ANNOTATION (Top-level data flow) ==================== -->
        <mxCell id="flow_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFFDE7;strokeColor=#FBC02D;fontSize=10;shadow=1;align=left;spacingLeft=8;" value="&lt;b&gt;Data Flow:&lt;/b&gt;&lt;br&gt;1. User/TRM → API (NGINX→Flask)&lt;br&gt;2. Flask → Task Queue (submit)&lt;br&gt;3. Scheduler → Task Queue (cron)&lt;br&gt;4. Workers consume → execute Kernel&lt;br&gt;5. Kernel ↔ Storage (read/write)&lt;br&gt;6. Kernel → Kafka (publish results)&lt;br&gt;7. All → Observability (metrics/logs)" vertex="1" tooltip="High-level data flow through the MAPPS platform.">
          <mxGeometry x="1840" y="80" width="230" height="145" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
