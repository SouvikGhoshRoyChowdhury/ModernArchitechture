<mxfile host="Electron" modified="2026-07-01T09:53:00.000Z" agent="draw.io" version="24.0.0">
  <diagram id="MAPPS_Architecture_UML" name="MAPPS Platform Architecture">
    <mxGraphModel dx="3000" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;dashed=1;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Legend&lt;/b&gt;" vertex="1">
          <mxGeometry x="20" y="20" width="1200" height="60" as="geometry" />
        </mxCell>
