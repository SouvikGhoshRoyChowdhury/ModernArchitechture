        </mxCell>

        <mxCell id="proc_adapter" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4FC3F7;strokeColor=#0277BD;fontSize=12;fontStyle=1;strokeWidth=2;" value="&lt;b&gt;🔌 Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal;&quot;&gt;Implements Model/Kernel&lt;br&gt;Connects External via Data Controller&lt;/font&gt;" vertex="1" tooltip="Adapter implements Model/Kernel. Acts as the medium to connect external systems via Data Controller Interface provided by MAPPS platform. Follows hexagonal/port-adapter architecture.">
          <mxGeometry x="500" y="780" width="280" height="65" as="geometry" />
