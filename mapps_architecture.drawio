        <mxCell id="stor_s3" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#4FC3F7;strokeColor=#0277BD;fontSize=12;fontStyle=1;" value="&lt;b&gt;☁️ S3 Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-weight:normal;&quot;&gt;External Source Data (raw/preprocessed)&lt;br&gt;Cache for Adapter during process run&lt;br&gt;Intermediate Results&lt;/font&gt;" vertex="1" tooltip="S3 stores external source data fetched by scheduler (raw or preprocessed). Acts as cache for adapter during process run. Also stores intermediate results.">
